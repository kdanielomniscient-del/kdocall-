<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>K.D.O CALL</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#121722;
    --panel:#1B2230;
    --panel-2:#232C3D;
    --line:#2C3545;
    --text:#F3EFE7;
    --muted:#8A93A6;
    --amber:#E8A33D;
    --amber-deep:#C9872A;
    --call:#E8603C;
    --bubble-me:#3A4A3E;
    --bubble-them:#232C3D;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);
    height:100vh;overflow:hidden;display:flex;justify-content:center}
  #app{width:100%;max-width:460px;height:100%;background:var(--bg);position:relative;overflow:hidden}
  .screen{position:absolute;inset:0;display:flex;flex-direction:column;transform:translateX(100%);
    transition:transform .32s cubic-bezier(.22,.9,.3,1);background:var(--bg)}
  .screen.active{transform:translateX(0)}
  .screen.under{transform:translateX(-25%);filter:brightness(.7)}

  /* --- Auth screens --- */
  .auth{justify-content:center;align-items:center;padding:36px 28px;gap:26px;text-align:center}
  .gift-mark{width:64px;height:64px;border-radius:18px;background:linear-gradient(145deg,var(--amber),var(--amber-deep));
    display:flex;align-items:center;justify-content:center;font-size:30px;box-shadow:0 10px 30px -8px rgba(232,163,61,.5)}
  .auth h1{font-family:'Fraunces',serif;font-size:28px;margin:0;letter-spacing:.2px}
  .auth p.sub{color:var(--muted);margin:-10px 0 4px;font-size:14.5px;line-height:1.5;max-width:320px}
  .field{width:100%;text-align:left}
  .field label{display:block;font-size:12.5px;color:var(--muted);margin-bottom:6px}
  .field input{width:100%;padding:13px 14px;border-radius:12px;border:1px solid var(--line);
    background:var(--panel);color:var(--text);font-size:15.5px;font-family:inherit}
  .field input:focus{outline:none;border-color:var(--amber)}
  .form-stack{width:100%;display:flex;flex-direction:column;gap:14px}
  .btn{width:100%;padding:14px;border-radius:14px;border:none;font-size:15.5px;font-weight:600;
    font-family:inherit;cursor:pointer;transition:transform .15s}
  .btn:active{transform:scale(.98)}
  .btn-primary{background:var(--amber);color:#1B1507}
  .btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--line)}
  .hint{font-size:13px;color:var(--muted)}
  .hint b{color:var(--text)}
  .otp-row{display:flex;gap:10px;justify-content:center}
  .otp-row input{width:46px;height:56px;text-align:center;font-size:22px;border-radius:12px;
    border:1px solid var(--line);background:var(--panel);color:var(--text)}
  .otp-row input:focus{outline:none;border-color:var(--amber)}

  /* --- Chat list --- */
  .topbar{padding:16px 18px;display:flex;align-items:center;gap:12px;background:var(--panel);
    border-bottom:1px solid var(--line);position:sticky;top:0;z-index:2}
  .topbar .gift-mark{width:34px;height:34px;border-radius:10px;font-size:16px;flex-shrink:0}
  .topbar h2{font-family:'Fraunces',serif;font-size:19px;margin:0}
  .topbar .status{font-size:11.5px;color:var(--amber);margin-top:1px}
  .list{overflow-y:auto;flex:1;padding:6px 10px}
  .convo{display:flex;align-items:center;gap:13px;padding:12px 10px;border-radius:14px;cursor:pointer}
  .convo:active{background:var(--panel)}
  .avatar{width:50px;height:50px;border-radius:50%;flex-shrink:0;object-fit:cover;
    border:2px solid var(--panel-2)}
  .convo .meta{flex:1;min-width:0}
  .convo .top-row{display:flex;justify-content:space-between;align-items:baseline}
  .convo .top-row b{font-size:15.5px}
  .convo .top-row span{font-size:11.5px;color:var(--muted)}
  .convo .preview{font-size:13.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
  .badge{background:var(--amber);color:#1B1507;font-size:11px;font-weight:700;border-radius:999px;
    min-width:20px;height:20px;display:flex;align-items:center;justify-content:center;padding:0 6px}
  .fab{position:absolute;bottom:24px;right:20px;width:54px;height:54px;border-radius:50%;
    background:var(--call);border:none;color:#fff;font-size:22px;box-shadow:0 10px 26px -6px rgba(232,96,60,.6)}

  /* --- Chat screen --- */
  .chat-top{display:flex;align-items:center;gap:12px;padding:14px 14px;background:var(--panel);
    border-bottom:1px solid var(--line)}
  .chat-top .back{background:none;border:none;color:var(--amber);font-size:20px;padding:4px}
  .chat-top .avatar{width:38px;height:38px}
  .chat-top b{font-size:15.5px;display:block}
  .chat-top span{font-size:11.5px;color:var(--muted)}
  .chat-top .call-btn{margin-left:auto;background:var(--panel-2);border:1px solid var(--line);
    width:38px;height:38px;border-radius:50%;color:var(--call);font-size:16px}
  .messages{flex:1;overflow-y:auto;padding:16px 12px;display:flex;flex-direction:column;gap:8px}
  .bubble{max-width:75%;padding:10px 13px;border-radius:16px;font-size:14.5px;line-height:1.4}
  .bubble.them{background:var(--bubble-them);align-self:flex-start;border-bottom-left-radius:4px}
  .bubble.me{background:var(--bubble-me);align-self:flex-end;border-bottom-right-radius:4px}
  .composer{display:flex;gap:8px;padding:10px;background:var(--panel);border-top:1px solid var(--line)}
  .composer input{flex:1;padding:12px 14px;border-radius:999px;border:1px solid var(--line);
    background:var(--panel-2);color:var(--text);font-size:14.5px;font-family:inherit}
  .composer input:focus{outline:none;border-color:var(--amber)}
  .composer button{width:42px;height:42px;border-radius:50%;border:none;background:var(--amber);
    color:#1B1507;font-size:17px;flex-shrink:0}

  ::-webkit-scrollbar{width:0}
</style>
</head>
<body>
<div id="app">

  <!-- SCREEN 1 : INSCRIPTION -->
  <div class="screen active" id="screen-signup">
    <div class="auth">
      <div class="gift-mark">🎁</div>
      <h1>K.D.O CALL</h1>
      <p class="sub">Discute avec tes proches partout dans le monde. Crée ton compte pour commencer.</p>
      <div class="form-stack">
        <div class="field"><label>Prénom</label><input id="su-first" placeholder="Ex. Daniel"></div>
        <div class="field"><label>Nom</label><input id="su-last" placeholder="Ex. Omniscient"></div>
        <div class="field"><label>Numéro de téléphone</label><input id="su-phone" type="tel" placeholder="+228 90 00 00 00"></div>
        <button class="btn btn-primary" onclick="goVerify()">Créer mon compte</button>
      </div>
      <p class="hint">Déjà inscrit ? <b onclick="skipToList()" style="cursor:pointer;color:var(--amber)">Ouvrir l'appli</b></p>
    </div>
  </div>

  <!-- SCREEN 2 : VERIFICATION -->
  <div class="screen" id="screen-verify">
    <div class="auth">
      <div class="gift-mark">✉️</div>
      <h1>Code de vérification</h1>
      <p class="sub">Un code à 4 chiffres a été envoyé par SMS au <b id="verify-phone" style="color:var(--text)"></b></p>
      <div class="otp-row">
        <input maxlength="1" inputmode="numeric">
        <input maxlength="1" inputmode="numeric">
        <input maxlength="1" inputmode="numeric">
        <input maxlength="1" inputmode="numeric">
      </div>
      <div class="form-stack">
        <button class="btn btn-primary" onclick="confirmVerify()">Valider le code</button>
        <button class="btn btn-ghost" onclick="goBack('screen-signup')">Renvoyer / modifier le numéro</button>
      </div>
    </div>
  </div>

  <!-- SCREEN 3 : LISTE DE DISCUSSIONS -->
  <div class="screen" id="screen-list">
    <div class="topbar">
      <div class="gift-mark">🎁</div>
      <div>
        <h2>K.D.O CALL</h2>
        <div class="status" id="welcome-line">Bienvenue</div>
      </div>
    </div>
    <div class="list" id="convo-list"></div>
    <button class="fab" onclick="openChat('new')">＋</button>
  </div>

  <!-- SCREEN 4 : CONVERSATION -->
  <div class="screen" id="screen-chat">
    <div class="chat-top">
      <button class="back" onclick="goBack('screen-list')">←</button>
      <img class="avatar" id="chat-avatar" src="">
      <div>
        <b id="chat-name"></b>
        <span>en ligne</span>
      </div>
      <button class="call-btn" onclick="alert('Appel K.D.O lancé 📞')">📞</button>
    </div>
    <div class="messages" id="chat-messages"></div>
    <div class="composer">
      <input id="chat-input" placeholder="Écris un message…" onkeydown="if(event.key==='Enter')sendMsg()">
      <button onclick="sendMsg()">➤</button>
    </div>
  </div>

</div>

<script>
const contacts = [
  {id:1, name:"Maman ❤️", avatar:"https://i.pravatar.cc/100?img=47", preview:"Merci pour le cadeau, mon fils", time:"09:12", unread:2,
    history:[{from:"them",text:"Merci pour le cadeau, mon fils 🙏"},{from:"them",text:"Tu rentres ce weekend ?"}]},
  {id:2, name:"Togo Travail 🇹🇬", avatar:"https://i.pravatar.cc/100?img=12", preview:"Nouvelle offre disponible", time:"08:40", unread:0,
    history:[{from:"them",text:"Nouvelle offre freelance disponible, ça t'intéresse ?"},{from:"me",text:"Oui, envoie les détails !"}]},
  {id:3, name:"Amis du Monde 🌍", avatar:"https://i.pravatar.cc/100?img=33", preview:"Partage ton calme", time:"hier", unread:0,
    history:[{from:"them",text:"On se motive ensemble cette semaine 💪"}]}
];

function renderList(){
  const el = document.getElementById('convo-list');
  el.innerHTML = contacts.map(c => `
    <div class="convo" onclick="openChat(${c.id})">
      <img class="avatar" src="${c.avatar}">
      <div class="meta">
        <div class="top-row"><b>${c.name}</b><span>${c.time}</span></div>
        <div class="preview">${c.preview}</div>
      </div>
      ${c.unread ? `<div class="badge">${c.unread}</div>` : ''}
    </div>`).join('');
}
renderList();

function show(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}
function goBack(id){ show(id); }

function goVerify(){
  const first = document.getElementById('su-first').value.trim();
  const last = document.getElementById('su-last').value.trim();
  const phone = document.getElementById('su-phone').value.trim();
  if(!first || !last || !phone){ alert("Remplis ton prénom, ton nom et ton numéro pour continuer."); return; }
  localStorage.setItem('kdo-user', JSON.stringify({first,last,phone}));
  document.getElementById('verify-phone').textContent = phone;
  show('screen-verify');
}

document.querySelectorAll('.otp-row input').forEach((inp,i,all)=>{
  inp.addEventListener('input', ()=>{ if(inp.value && all[i+1]) all[i+1].focus(); });
});

function confirmVerify(){
  const code = [...document.querySelectorAll('.otp-row input')].map(i=>i.value).join('');
  if(code.length < 4){ alert("Entre les 4 chiffres reçus par SMS."); return; }
  const user = JSON.parse(localStorage.getItem('kdo-user')||'{}');
  document.getElementById('welcome-line').textContent = `Connecté en tant que ${user.first||''}`;
  show('screen-list');
}

function skipToList(){ show('screen-list'); }

let current = null;
function openChat(id){
  const c = contacts.find(x=>x.id===id) || {id:'new', name:"Nouvelle discussion", avatar:"https://i.pravatar.cc/100?img=5", history:[]};
  current = c;
  document.getElementById('chat-name').textContent = c.name;
  document.getElementById('chat-avatar').src = c.avatar;
  renderMessages();
  show('screen-chat');
}

function renderMessages(){
  const box = document.getElementById('chat-messages');
  box.innerHTML = current.history.map(m=>`<div class="bubble ${m.from==='me'?'me':'them'}">${m.text}</div>`).join('');
  box.scrollTop = box.scrollHeight;
}

function sendMsg(){
  const input = document.getElementById('chat-input');
  const text = input.value.trim();
  if(!text) return;
  current.history.push({from:'me', text});
  input.value = '';
  renderMessages();
}
</script>
</body>
</html>
